# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# All variables are prefixed with DATASET_ and loaded by dataset_builder.config.

# Directories (relative to the project root or absolute)
DATASET_RAW_DIR=data/raw
DATASET_PROCESSED_DIR=data/processed

# Output
DATASET_NAME=my_dataset
DATASET_SEED=42

# Logging: DEBUG | INFO | WARNING | ERROR
DATASET_LOG_LEVEL=INFO

# Secrets (e.g. for a data source or Hugging Face upload)
# DATASET_HF_TOKEN=
