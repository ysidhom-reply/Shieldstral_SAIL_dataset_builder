# Copy this file to `.env` in the repository root and fill in the values.
# `.env` is git-ignored: never commit real values, and never paste them into chats or reports.
# An environment variable with the same name takes precedence over `.env`.
#
#   MISTRAL_API_KEY   P3: benign-text generation (Mistral Small) and the judge (Mistral Medium)
#   HF_TOKEN          only for the final push to Hugging Face (P10)

MISTRAL_API_KEY=
HF_TOKEN=

# All other settings live in configs/config.yaml.
